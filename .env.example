# ==============================================================================
# SHREEKAMALINEE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Port & Swagger / OpenAPI
PORT=8081
# Set to false in production for security, true for local development
SWAGGER_ENABLED=false

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/shreekamalinee
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DDL_AUTO=update

# Redis Cache (Optional, set CACHE_TYPE=none if Redis is not used)
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TYPE=none

# Mail Server Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=Shreekamalinee <orders@shreekamalinee.com>

# Security & JWT Configuration
# Generate a strong 256-bit or 512-bit secret for production
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_for_hs512_security
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=7776000000
HMAC_SECRET=your_hmac_secret_key_for_signature_verification

# Cookie Security Settings
# Local Dev: COOKIE_SECURE=false, COOKIE_SAME_SITE=Lax
# Production Cross-Domain: COOKIE_SECURE=true, COOKIE_SAME_SITE=None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Supabase Storage for Product Images
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_BUCKET=shreekamalinee

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Local Dev: http://localhost:5173,http://localhost:3000
# Production: https://shreekamalinee-frontend.vercel.app,https://shreekamalinee.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://shreekamalinee-frontend.vercel.app

# Initial Administrator Seed Account
ADMIN_EMAIL=admin@shreekamalinee.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NOTIFICATION_EMAIL=admin@shreekamalinee.com