# --- SERVER & CORS ---
PORT=8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://renaissance-zeta.vercel.app

# --- DATABASE CONFIGURATION ---
DB_URL=jdbc:postgresql://localhost:5432/shreekamalinee
DB_USERNAME=postgres
